# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=online_clinic
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Server Configuration
PORT=5000
NODE_ENV=development

# Google OAuth / Calendar Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Dhaka

# Google Login (separate OAuth client, if used)
GOOGLE_LOGIN_CLIENT_ID=your_google_login_client_id
GOOGLE_LOGIN_CLIENT_SECRET=your_google_login_client_secret
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/auth/google/login/callback
